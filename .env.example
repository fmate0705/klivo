# ============================================================================
# Klivo — példa környezeti változók (másold .env néven, töltsd ki).
# A .env SOHA ne kerüljön verziókezelésbe (lásd .gitignore).
#
# Helyi fejlesztésben a docker-compose Mailpit szolgáltatása fogadja a leveleket
# (web: http://localhost:8025), így nem kell valós SMTP a teszteléshez.
# Élesben add meg a valós levelezőszolgáltató (SMTP) adatait.
# ============================================================================

# --- SMTP a kapcsolati űrlap e-mailjeihez ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Feladó és címzett
MAIL_FROM=Klivo weboldal <no-reply@klivo.hu>
MAIL_TO=hello@klivo.hu

# --- Publikus alap-URL (canonical, OG, sitemap) ---
NEXT_PUBLIC_SITE_URL=https://klivo.hu
