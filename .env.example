# =============================================================================
# Klivo — környezeti beállítások
# =============================================================================
# Másold `.env` néven, és töltsd ki. A `.env` gitignore-olt, és soha nem szabad
# commitolni: az admin munkamenetek aláíró kulcsát és a jelszó hash-ét
# tartalmazza.
#
# Ez a fájl a jogi és cégadatok EGYETLEN forrása. Ami itt van, az jelenik meg a
# láblécben, a kapcsolat oldalon, az impresszumban, az ÁSZF-ben, az adatkezelési
# és a cookie tájékoztatóban, valamint a keresőknek küldött strukturált adatban.
# Nincs mögötte admin felület: két szerkesztési hely két egymásnak ellentmondó
# impresszumot jelentene.
#
# A ki nem töltött mezők helyén `[szögletes zárójeles]` helyőrző látszik az
# oldalon. Ez szándékos: élesítés előtt nyisd meg mind a négy jogi oldalt, és
# nézd végig, maradt-e bennük szögletes zárójel.
#
# Mezőnkénti magyarázat és kitöltött minta: docs/JOGI-ADATOK.md
#
# A `.env` módosítása után a szervert (konténert) újra kell indítani. Újra
# buildelni **nem** kell: a nyilvános oldalak kérésre renderelődnek, tehát a
# cég- és jogi adatokat mindig a futó konténer környezetéből olvassák.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Az oldal címe
# -----------------------------------------------------------------------------

# A publikus origin, záró perjel NÉLKÜL.
# Ebből készül a canonical URL, a sitemap, az OG tag és a strukturált adat.
# Ha ez rossz, a produkcióba localhost URL-ek kerülnek — ez a leggyakoribb
# Next.js deploy hiba.
NEXT_PUBLIC_SITE_URL=https://klivo.hu


# -----------------------------------------------------------------------------
# 2. Elérhetőség
# -----------------------------------------------------------------------------
# A `NEXT_PUBLIC_` előtaggal jelöltek a böngészőbe is bekerülnek (a hibaoldal
# használja őket), ezért build időben kell megadni.

# E-mail cím. Ez jelenik meg a láblécben, a kapcsolat oldalon és az
# impresszumban, és erre mutat a `mailto:` hivatkozás.
NEXT_PUBLIC_CONTACT_EMAIL=hello@klivo.hu

# Telefonszám, ahogy ki szeretnéd írni. A hívható `tel:` link automatikusan
# készül belőle (szóközök és kötőjelek nélkül, a `+`-t megtartva).
NEXT_PUBLIC_CONTACT_PHONE=+36 30 000 0000

# Kiszolgált terület. A keresőknek küldött strukturált adatba is bekerül.
CONTACT_AREA_SERVED=Magyarország

# Ügyfélfogadás, szabad szöveggel.
CONTACT_HOURS=Hétköznap 9:00 és 17:00 között

# Válaszidő-ígéret. A kapcsolat oldalon és a záró szekcióban jelenik meg.
CONTACT_RESPONSE_TIME=Egy munkanapon belül válaszolunk.


# -----------------------------------------------------------------------------
# 3. Cégadatok — impresszum és ÁSZF
# -----------------------------------------------------------------------------

# Teljes, jogi cégnév. Az impresszum és az ÁSZF első sora, és a lábléc
# szerzői jogi sora.
# Például: Klivo Kft. — vagy egyéni vállalkozónál a saját név.
COMPANY_LEGAL_NAME=

# Székhely, három külön mezőben. Azért három, mert az oldalon is három külön
# helyőrző jelenik meg helyettük — így egyértelmű, melyiket hova kell írni. A
# megjelenő cím ezekből áll össze: "1094 Budapest, Példa utca 12. 3. em. 4."
# A strukturált adatba is külön mezőként kerülnek (irányítószám, település,
# közterület), nem egyetlen sztringként.
COMPANY_POSTCODE=
COMPANY_CITY=
COMPANY_STREET=

# Adószám.
COMPANY_TAX_NUMBER=

# Cégjegyzékszám (cégeknél) vagy nyilvántartási szám (egyéni vállalkozónál).
COMPANY_REGISTRATION_NUMBER=

# A képviselő neve.
COMPANY_REPRESENTATIVE=

# Számlavezető bank és számlaszám. Az impresszumban jelenik meg.
COMPANY_BANK=

# Tárhelyszolgáltató: név, székhely és elérhetőség egyben.
# Az impresszumban kötelező adat, és az adatkezelési tájékoztató is hivatkozik
# rá adatfeldolgozóként.
#
# Bérelt VPS-en azt a céget kell megnevezni, akinek a vasán az adat fizikailag
# van — a saját üzemeltetői rétegeid (Docker, konténerek) nem külön szereplők.
# Például: Példa Hosting Zrt., 1111 Budapest, Példa utca 1., info@peldahosting.hu
COMPANY_HOSTING_PROVIDER=

# Felügyeleti szerv neve és elérhetősége (az impresszumban).
# Például: Budapest Főváros Kormányhivatala, Fogyasztóvédelmi Főosztály
COMPANY_SUPERVISORY_AUTHORITY=

# Az illetékes békéltető testület neve és elérhetősége (az ÁSZF jogorvoslati
# pontjában). A székhely szerint illetékes testületet kell megadni.
# Például: Budapesti Békéltető Testület, 1016 Budapest, Krisztina krt. 99.
COMPANY_DISPUTE_RESOLUTION=


# -----------------------------------------------------------------------------
# 4. Szerződéses és adatkezelési határidők
# -----------------------------------------------------------------------------
# Ezek a jogi dokumentumok szövegébe kerülnek be. Jogi döntések, ezért nincs
# hozzájuk alapértelmezés — jogi szakemberrel egyeztetve töltsd ki.

# Az üzemeltetési szerződés felmondási ideje (ÁSZF 8. pont).
# A mondatba olvad: "... felmondhatja ..., {ide kerül} felmondási idővel."
# Melléknévi alak kell. Például: 30 napos
COMPANY_NOTICE_PERIOD=

# Meddig őrzitek a kapcsolatfelvételi űrlapon érkezett megkereséseket
# (adatkezelési tájékoztató 3. pont).
# A mondatba olvad: "A megkereséseket a megválaszolást követő {ide kerül}, ..."
# Raggal együtt add meg. Például: 12 hónapig
COMPANY_LEAD_RETENTION=

# Meddig őrzitek a szerverek technikai naplóit (adatkezelési tájékoztató 3. pont).
# A mondatba olvad: "... naplóit legfeljebb {ide kerül} tároljuk."
# Raggal együtt add meg, és ellenőrizd, hogy a valóságban is ennyi.
# Például: 30 napig
COMPANY_LOG_RETENTION=

# A jogi dokumentumok hatálybalépése, ahogy meg szeretnéd jeleníteni.
# Például: 2026. augusztus 20.
COMPANY_EFFECTIVE_DATE=


# -----------------------------------------------------------------------------
# 5. Admin belépés
# -----------------------------------------------------------------------------
# Az admin egyetlen dolgot csinál: blogbejegyzéseket lehet vele írni, szerkeszteni
# és publikálni, illetve a beérkezett megkereséseket megnézni.

# A munkamenet JWT aláíró kulcsa. Legalább 32 karakter; enélkül az alkalmazás
# nem ad ki és nem fogad el tokent.
#   Generálás:  npm run gen:secret
# Az érték cseréje azonnal érvényteleníti az összes élő munkamenetet.
ADMIN_JWT_SECRET=

# Az admin felhasználónév.
ADMIN_USERNAME=admin

# Az admin jelszó PBKDF2 hash-e — soha nem maga a jelszó.
#   Generálás:  npm run gen:password -- "a jelszavad"
# Formátum: pbkdf2.<iteráció>.<base64 salt>.<base64 kulcs>
#
# Az elválasztó szándékosan "." és nem "$": a Next.js dotenv-expand-del olvassa
# ezt a fájlt, ami a "$210000"-t változó hivatkozásként értelmezné és kifejtené,
# némán elrontva a hash-t. Ne írd át.
ADMIN_PASSWORD_HASH=


# -----------------------------------------------------------------------------
# 6. Tárolás és futásidő
# -----------------------------------------------------------------------------

# Hol élnek a JSON adatfájlok (bejegyzések, megkeresések).
# Alapértelmezés: ./data. Dockerben csatolt volume-ra kell mutatnia, különben
# minden bejegyzés és megkeresés elvész a következő deploynál.
# DATA_DIR=/app/data

NODE_ENV=production
PORT=3000
