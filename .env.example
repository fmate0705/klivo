# ============================================================================
# Klivo — példa környezeti változók (másold .env néven, töltsd ki).
# A .env SOHA ne kerüljön verziókezelésbe (lásd .gitignore).
# ============================================================================

# --- Publikus alap-URL (canonical, OG, sitemap) ---
NEXT_PUBLIC_SITE_URL=https://klivo.hu

# ============================================================================
# E-MAIL (SMTP) — JELENLEG KIKAPCSOLVA
# ----------------------------------------------------------------------------
# A kapcsolati űrlap e-mail küldése ki van kapcsolva (lásd
# docs/decisions/0005-disable-email.md), ezért ezekre a változókra most NINCS
# szükség, és a hiányuk sem okoz hibát a futásban.
#
# Visszakapcsoláshoz vedd ki a kommentből az alábbiakat, töltsd ki egy valós
# SMTP szolgáltató adataival, és állítsd vissza az /api/contact route +
# lib/email.ts implementációt.
# ============================================================================
# SMTP_HOST=smtp.pelda.hu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
#
# MAIL_FROM=Klivo weboldal <no-reply@klivo.hu>
# MAIL_TO=hello@klivo.hu
